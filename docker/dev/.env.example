# Ports accessibles uniquement sur 127.0.0.1.
DOCKER_HOST_IP=127.0.0.1
#DOCKER_HOST_IP=0.0.0.0  # To listen on all IP
HTTP_PORT=8088
DB_PORT=3307
PHPMYADMIN_PORT=8081
ADMINER_PORT=8082
MAILPIT_PORT=8025
SMTP_PORT=1025

# true : PHP en DEV, avec les Vite sélectionnés ; false : assets compilés.
APP_DEV=true
# Vite Core peut être arrêté en gardant PHP en DEV ; ses assets doivent alors être compilés.
DEV_CORE_VITE=true
# Une extension à la fois en HMR ; vide pour utiliser uniquement les builds installés.
DEV_EXTENSION=
# Exemple : DEV_EXTENSION=plugins/Lms
DEV_EXTENSION_VITE_PORT=3001
# Facultatif si le site est ouvert sur un autre domaine que localhost.
# VITE_BACKEND_ORIGIN=http://tycms.fr:8088

DB_NAME=tycms
DB_USER=tycms
DB_PASSWORD=tycms_dev
DB_ROOT_PASSWORD=root_dev
# true : connexion automatique root à phpMyAdmin et Adminer ; false : connexion manuelle.
DB_ADMIN_AUTO_LOGIN=false
TEST_DB_PASSWORD=tycms_test_dev
# start.sh ajoute une clé aléatoire persistante au premier lancement.
