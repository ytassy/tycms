Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On
    # Ne pas exposer le verrou ni les installations encore incomplètes.
    RewriteRule (^|/)\. - [F,L]
</IfModule>

<IfModule mod_mime.c>
    AddType font/woff2 .woff2
    AddType text/plain .txt
</IfModule>

<IfModule mod_headers.c>
    <FilesMatch "\.(woff2|css|txt)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
</IfModule>
